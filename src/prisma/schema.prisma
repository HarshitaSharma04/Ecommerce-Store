// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String   @unique
  password  String
  contact   String?
  gender    String?
  address   String?
  avatar    String?
  role      String   // 'admin' or 'customer'
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  // Relations
  products Product[] @relation("UserProducts")
  carts    Cart[]    @relation("UserCarts")     // ✅ Added this
}

type Variant {
  variantId   String
  name        String
  description String
  price       Float
  stock       Int
  image       String
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sku         String
  slug        String   @unique
  name        String
  description String
  variant     Variant[]
  collection  String?
  image       String
  status      String   @default("active")
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  user        User     @relation("UserProducts", fields: [merchantId], references: [id])
  merchantId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems   Cart[] @relation("ProductCartItems") // ✅ Added this
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String
  image       String
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Orders {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
}

model Cart {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?
  productId  String
  variantId  String
  name       String
  image      String
  price      Float
  quantity   Int
  createdAt  DateTime @default(now())

  user       User?    @relation("UserCarts", fields: [userId], references: [id])
  product    Product  @relation("ProductCartItems", fields: [productId], references: [id]) // ✅ NEW
}

